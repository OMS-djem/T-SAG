rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'TECHNICIAN';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'ADMIN' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'etb.djemil@gmail.com' ||
          request.auth.token.email.lower() == 'maamardjemil@gmail.com'
        ))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'isActive'])
        && data.uid is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3
        && data.role in ['ADMIN', 'OM', 'SUPERVISION', 'TECHNICIAN', 'DISPATCHER', 'ACQUISITION']
        && data.isActive is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMailConfig(data) {
      return data.keys().hasAll(['senderEmail', 'senderName', 'toGroup', 'ccGroup'])
        && data.senderEmail is string
        && data.senderName is string
        && data.toGroup is string
        && data.ccGroup is string
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSiteReport(data) {
      return data.keys().hasAll(['siteId', 'siteName', 'status', 'technicianUid'])
        && data.siteId is string && data.siteId.size() > 0
        && data.siteName is string
        && data.status in ['ACCORDED', 'REFUSED']
        && data.technicianUid is string
        && (!('latitude' in data) || data.latitude is number)
        && (!('longitude' in data) || data.longitude is number)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.uid == userId)
        || isAdmin()
      ) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.uid == userId && request.resource.data.role == resource.data.role)
        || isAdmin()
      ) && isValidUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /mail_config/{configId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidMailConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    match /site_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.technicianUid == request.auth.uid && isValidSiteReport(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.technicianUid == request.auth.uid || isAdmin()) && isValidSiteReport(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
